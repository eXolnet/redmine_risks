<%= title [l(:label_risks), settings_project_path(@project, :tab => 'risks')], @category.name %>

<%= form_tag(project_risk_category_path(@project, @category), :method => :delete, :id => 'risk-category-destroy-form') do %>
<div class="box">
<p><strong><%= l(:text_enumeration_destroy_question, :name => @category.name, :count => @category.objects_count) %></strong></p>
<p><label for="reassign_to_id"><%= l(:text_enumeration_category_reassign_to) %></label>
<%= select_tag 'reassign_to_id', (content_tag('option', l(:label_none), :value => '') + options_from_collection_for_select(@categories, 'id', 'name')) %></p>
</div>

<%= submit_tag l(:button_apply) %>
<%= link_to l(:button_cancel), settings_project_path(@project, :tab => 'risks') %>
<% end %>
