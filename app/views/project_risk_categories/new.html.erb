<h2><%= l(:label_risk_category_new) %></h2>

<%= labelled_form_for @category, :as => :risk_category,
                      :url => project_risk_categories_path(@project), :html => {:method => :post, :id => 'risk-category-form'} do |f| %>
<%= render :partial => 'project_risk_categories/form', :locals => {:f => f} %>
<%= submit_tag l(:button_create) %>
<%= link_to l(:button_cancel), settings_project_path(@project, :tab => 'risks') %>
<% end %>
